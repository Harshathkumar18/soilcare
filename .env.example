# SoilVision AI Environment Configuration

# Flask Secret Key for session management and CSRF safety
FLASK_SECRET_KEY=soilvision-ai-development-secret-key-change-in-production

# Flask environment
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Optional: Google Gemini API Key for AI Soil Assistant
# Get a free key at: https://aistudio.google.com/
# If left empty, the built-in Agricultural Expert Engine will answer questions offline!
GEMINI_API_KEY=

# Upload directory (defaults to ./uploads)
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760 # 10MB in bytes
